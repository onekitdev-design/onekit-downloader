# Required. Shared secret between Vercel and this VPS. Never expose to browsers.
# Generate with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret

# Listen address (Docker should use 0.0.0.0)
HOST=0.0.0.0
PORT=8787

# bgutil HTTP provider on the Docker network (do not publish this port publicly)
POT_PROVIDER_URL=http://pot-provider:4416

# yt-dlp player clients — update this when YouTube extraction behavior changes
YTDLP_PLAYER_CLIENT=mweb,tv,web_safari

# Force IPv4 (often more reliable from datacenter VPS networks)
YTDLP_FORCE_IPV4=1

# Safety limits
MAX_DURATION_SECONDS=7200
MAX_DOWNLOAD_MB=500
MAX_ACTIVE_JOBS=3
MAX_QUEUED_JOBS=50
JOB_TTL_MS=900000
DOWNLOAD_TIMEOUT_MS=600000
EXTRACT_TIMEOUT_MS=90000

# Rate limits (per client IP, behind a reverse proxy)
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=60000
DOWNLOAD_RATE_LIMIT_MAX=10

# Optional public origin of the OneKit site, used only if you serve signed downloads to browsers
# ONEKIT_ORIGIN=https://your-onekit-domain.com
